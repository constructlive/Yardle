NODE_ENV=production
NEXT_PUBLIC_APP_NAME=Yardle
NEXT_PUBLIC_APP_URL=https://yardle.andersonyard.co.uk

DATABASE_URL=mysql://yardle_user:CHANGE_ME@127.0.0.1:3306/yardle
# Or use individual variables instead of DATABASE_URL:
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=yardle
# DB_USER=yardle_user
# DB_PASSWORD=CHANGE_ME

AUTH_SECRET=CHANGE_ME
AUTH_TRUST_HOST=true
NEXTAUTH_URL=https://yardle.andersonyard.co.uk

SMS_PROVIDER=mock # mock or twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
VONAGE_API_KEY=
VONAGE_API_SECRET=
TEXTLOCAL_API_KEY=