# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=yardle
# DB_USER=yardle_user
# DB_PASSWORD=CHANGE_ME

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-random-password
AUTH_SECRET=CHANGE_ME

SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
VONAGE_API_KEY=
VONAGE_API_SECRET=
TEXTLOCAL_API_KEY=