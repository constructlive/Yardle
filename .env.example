NODE_ENV=production
NEXT_PUBLIC_APP_NAME=Yardle
NEXT_PUBLIC_APP_URL=https://yardle.andersonyard.co.uk

DATABASE_URL=mysql://yardle_user:CHANGE_ME@127.0.0.1:3306/yardle
